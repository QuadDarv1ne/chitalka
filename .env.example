# Database URL (SQLite by default)
DATABASE_URL="file:./db/custom.db"

# JWT secret — must be at least 32 characters in production!
# Generate with: openssl rand -hex 32
JWT_SECRET="dev-secret-please-change-in-production-32chars-min"

# Public app URL (for email links).
# Leave EMPTY when behind a reverse proxy (Caddy/nginx) — the app will then
# use the Host header from incoming requests. Set it only if the server is
# reached by a different public address than the Host header.
# NEXT_PUBLIC_APP_URL="https://reader.example.com"

# Set to "false" only if the app is served over plain HTTP (e.g. LAN without
# TLS) — otherwise the Secure cookie flag will make login/registration fail.
# COOKIE_SECURE=false

# Set to "true" when the app runs behind a reverse proxy that strips
# client-supplied X-Forwarded-For / X-Real-IP headers (see Caddyfile).
# This enables rate limiting and session logging by real client IP.
# TRUST_PROXY=true

# Email service (optional, only for production SMTP)
# RESEND_API_KEY="re_xxx"
# Sender address must be from a verified domain in your Resend account;
# defaults to "Читалка <onboarding@resend.dev>" (works for testing only).
# RESEND_FROM="Читалка <no-reply@yourdomain.com>"

# Dev-only token protecting the GET /api/auth/emails inbox preview endpoint.
# DEV_EMAIL_TOKEN="dev-inbox-token"

# ===== Amvera Cloud (production) =====
# The app is deployed as a Docker image (see amvera.yaml + Dockerfile) and
# reads secrets from the dashboard («Переменные и секреты»), NOT from .env.
# These are the values to set there:
#   DATABASE_URL="file:/data/chitalka.db"                 (persistent volume,
#   so the SQLite file survives redeploys — see Dockerfile CMD that applies
#   the Prisma schema with `prisma db push` on every start)
#   JWT_SECRET="$(openssl rand -hex 32)"               (must be ≥ 32 chars)
#   NEXT_PUBLIC_APP_URL="https://chitalka.<user>.amvera.io"  (required in prod —
#   email links; the app refuses to build/send without it)
#   TRUST_PROXY="true"       (the Amvera edge terminates TLS; X-Forwarded-For
#   is set only by the platform, so rate limiting keys on the real client IP)
#   RESEND_API_KEY="re_xxx"  (optional — enables real email delivery)
#   RESEND_FROM="Читалка <no-reply@yourdomain.com>" (optional sender override)
# The same values should be written to the local .env (gitignored) if you run
# the Docker image manually: docker run --env-file .env ...
